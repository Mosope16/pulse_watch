generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

enum Role {
  OWNER
  ADMIN
  MEMBER
}

enum MonitorStatus {
  UP
  DEGRADED
  DOWN
  PAUSED
}

enum MonitorMethod {
  GET
  POST
  HEAD
}

enum IncidentStatus {
  INVESTIGATING
  IDENTIFIED
  MONITORING
  RESOLVED
}

enum IncidentSeverity {
  CRITICAL
  MAJOR
  MINOR
}

enum NotificationType {
  MONITOR_DOWN
  MONITOR_RECOVERED
  INCIDENT_CREATED
  INCIDENT_RESOLVED
  INVITATION
}

// ---------------------------------------------------------
// Better Auth Core Models
// ---------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  sessions      Session[]
  accounts      Account[]
  memberships   Membership[]
  notifications Notification[]
  alertPrefs    AlertPreference[]

  @@map("users")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model Account {
  id                    String    @id @default(cuid())
  userId                String
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@map("accounts")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([identifier, value])
  @@map("verifications")
}

// ---------------------------------------------------------
// Workspace & Tenant Isolation Models
// ---------------------------------------------------------

model Workspace {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  logoUrl     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  memberships  Membership[]
  invitations  Invitation[]
  monitors     Monitor[]
  incidents    Incident[]
  notifications Notification[]
  alertPrefs   AlertPreference[]
  statusPage   StatusPage?

  @@map("workspaces")
}

model Membership {
  id          String    @id @default(cuid())
  workspaceId String
  userId      String
  role        Role      @default(MEMBER)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
  @@map("memberships")
}

model Invitation {
  id          String    @id @default(cuid())
  workspaceId String
  email       String
  role        Role      @default(MEMBER)
  token       String    @unique
  invitedById String
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime  @default(now())

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, email])
  @@map("invitations")
}

// ---------------------------------------------------------
// Monitoring Models
// ---------------------------------------------------------

model Monitor {
  id                 String        @id @default(cuid())
  workspaceId        String
  name               String
  url                String
  method             MonitorMethod @default(GET)
  interval           Int           @default(60) // in seconds (60, 300, 600, 1800)
  timeout            Int           @default(10000) // in milliseconds
  expectedStatus     Int           @default(200)
  expectedText       String?
  headers            String?       // JSON object string
  body               String?
  enabled            Boolean       @default(true)
  status             MonitorStatus @default(UP)
  consecutiveFailures Int          @default(0)
  failureThreshold   Int           @default(3)
  degradedThresholdMs Int          @default(2000) // response time threshold for DEGRADED

  lastCheckAt        DateTime?
  lastStatusChangeAt DateTime?

  // Aggregated metrics
  uptime24h          Float         @default(100.0)
  uptime30d          Float         @default(100.0)
  avgResponseTime    Float         @default(0.0)

  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  workspace          Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  checks             MonitorCheck[]
  incidents          Incident[]
  statusPageMonitors StatusPageMonitor[]

  @@index([workspaceId, enabled])
  @@index([enabled, interval])
  @@map("monitors")
}

model MonitorCheck {
  id           String    @id @default(cuid())
  monitorId    String
  statusCode   Int?
  responseTime Int       // in milliseconds
  isSuccess    Boolean
  isDegraded   Boolean   @default(false)
  errorMessage String?
  errorType    String?
  duration     Int       // total roundtrip duration in ms
  createdAt    DateTime  @default(now())

  monitor      Monitor   @relation(fields: [monitorId], references: [id], onDelete: Cascade)

  @@index([monitorId, createdAt(sort: Desc)])
  @@map("monitor_checks")
}

// ---------------------------------------------------------
// Incident Management Models
// ---------------------------------------------------------

model Incident {
  id              String           @id @default(cuid())
  workspaceId     String
  monitorId       String
  title           String
  status          IncidentStatus   @default(INVESTIGATING)
  severity        IncidentSeverity @default(CRITICAL)
  cause           String?
  startedAt       DateTime         @default(now())
  acknowledgedAt  DateTime?
  resolvedAt      DateTime?
  durationSeconds Int?

  workspace       Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  monitor         Monitor          @relation(fields: [monitorId], references: [id], onDelete: Cascade)
  updates         IncidentUpdate[]

  @@index([workspaceId, status])
  @@index([monitorId, status])
  @@map("incidents")
}

model IncidentUpdate {
  id         String         @id @default(cuid())
  incidentId String
  status     IncidentStatus
  message    String
  createdBy  String?        // user name or "PulseWatch Automation"
  createdAt  DateTime       @default(now())

  incident   Incident       @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  @@index([incidentId, createdAt])
  @@map("incident_updates")
}

// ---------------------------------------------------------
// Notifications & Preferences
// ---------------------------------------------------------

model Notification {
  id          String           @id @default(cuid())
  workspaceId String
  userId      String?          // null = broadcast to workspace members
  title       String
  message     String
  type        NotificationType
  link        String?
  isRead      Boolean          @default(false)
  createdAt   DateTime         @default(now())

  workspace   Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User?            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([workspaceId, isRead])
  @@index([userId, isRead])
  @@map("notifications")
}

model AlertPreference {
  id               String    @id @default(cuid())
  workspaceId      String
  userId           String
  emailAlerts      Boolean   @default(true)
  inAppAlerts      Boolean   @default(true)
  notifyOnDown     Boolean   @default(true)
  notifyOnRecover  Boolean   @default(true)
  notifyOnIncident Boolean   @default(true)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  workspace        Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@map("alert_preferences")
}

// ---------------------------------------------------------
// Public Status Page Models
// ---------------------------------------------------------

model StatusPage {
  id          String              @id @default(cuid())
  workspaceId String              @unique
  slug        String              @unique
  title       String
  description String?
  isPublic    Boolean             @default(true)
  logoUrl     String?
  supportUrl  String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  workspace   Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  monitors    StatusPageMonitor[]

  @@map("status_pages")
}

model StatusPageMonitor {
  id           String     @id @default(cuid())
  statusPageId String
  monitorId    String
  displayName  String?
  displayOrder Int        @default(0)
  isVisible    Boolean    @default(true)
  createdAt    DateTime   @default(now())

  statusPage   StatusPage @relation(fields: [statusPageId], references: [id], onDelete: Cascade)
  monitor      Monitor    @relation(fields: [monitorId], references: [id], onDelete: Cascade)

  @@unique([statusPageId, monitorId])
  @@map("status_page_monitors")
}
