# Database (PostgreSQL / Neon)
DATABASE_URL="postgresql://user:password@host/neondb?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://user:password@host/neondb?sslmode=require"

# Queue / Cache (Redis / Valkey)
REDIS_URL="redis://127.0.0.1:6379"

# Authentication (Better Auth)
BETTER_AUTH_SECRET="your-32-char-random-secret-key-here"
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Email Delivery (Resend)
RESEND_API_KEY="re_your_api_key_here"
RESEND_FROM_EMAIL="PulseWatch <notifications@resend.dev>"

# Monitoring Defaults
CONSECUTIVE_FAILURES_THRESHOLD=3
DEFAULT_CHECK_TIMEOUT_MS=10000
