# Database (Neon Serverless Postgres)
DATABASE_URL="postgresql://user:password@host-pooler.c-9.us-east-2.aws.neon.tech/neondb?sslmode=require&pgbouncer=true&connect_timeout=15"
DATABASE_URL_UNPOOLED="postgresql://user:password@host.c-9.us-east-2.aws.neon.tech/neondb?sslmode=require&connect_timeout=15"

# Queue / Cache (Redis / Valkey)
REDIS_URL="redis://127.0.0.1:6379"

# Authentication (Better Auth)
BETTER_AUTH_SECRET="your-32-char-random-secret-key-here"
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Email Delivery (Resend)
RESEND_API_KEY="re_your_api_key_here"
RESEND_FROM_EMAIL="PulseWatch <notifications@resend.dev>"

# Monitoring Engine Configuration
CONSECUTIVE_FAILURES_THRESHOLD=3
DEFAULT_CHECK_TIMEOUT_MS=10000

# Neon Platform Services
NEON_BRANCH="production"
NEON_AUTH_BASE_URL="https://your-endpoint.neonauth.c-9.us-east-2.aws.neon.tech/neondb/auth"
NEON_AUTH_JWKS_URL="https://your-endpoint.neonauth.c-9.us-east-2.aws.neon.tech/neondb/auth/.well-known/jwks.json"

# Neon Realtime
NEON_REALTIME_URL="wss://your-endpoint.rt.c-9.us-east-2.aws.neon.tech/"
NEON_REALTIME_SECRET="nrt_live_your_realtime_secret"

# Neon Object Storage (S3-compatible)
AWS_ACCESS_KEY_ID="nak_live_your_key_id"
AWS_SECRET_ACCESS_KEY="nsk_live_your_secret_key"
AWS_ENDPOINT_URL_S3="https://your-branch.storage.c-9.us-east-2.aws.neon.tech"
AWS_REGION="us-east-2"
NEON_STORAGE_BUCKET="assets"

# Neon Functions
NEON_FUNCTION_HELLO_BASE_URL="https://your-branch-hello.compute.c-9.us-east-2.aws.neon.tech"
